{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoidRecoverPS5",
  "version": "0.1.0",
  "identifier": "com.voidfnc.voidrecoverps5",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoidRecoverPS5",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "languages": ["English", "Russian", "SimpChinese", "Spanish", "French", "German", "PortugueseBR", "Turkish", "Polish", "Japanese", "Korean", "Italian"],
        "displayLanguageSelector": true,
        "customLanguageFiles": { "Polish": "installer/Polish.nsh" }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
